{
  "schemaVersion": 1,
  "id": "dizziee.unifi-panel",
  "name": "UniFi",
  "version": "0.6.0",
  "author": "Jonny Heggheim",
  "license": "MIT",
  "description": "Watch your UniFi network from the Omarchy bar: access points, switches and gateways with their online state, the gateway's WAN graph and links, overall client counts, and a notification when a device drops.",
  "homepage": "https://github.com/JJDizz1L/dizziee.unifi-panel",
  "repository": "https://github.com/JJDizz1L/dizziee.unifi-panel",
  "keywords": [
    "unifi",
    "ubiquiti",
    "network",
    "monitoring"
  ],
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "UnifiWidget.qml"
  },
  "barWidget": {
    "displayName": "UniFi",
    "description": "UniFi device state, WAN graph and client counts from your Network controller",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showBarClients": false,
      "showGatewayStats": true,
      "showWifi": true,
      "showNetworks": true,
      "showVpn": true,
      "showClients": false,
      "refreshIntervalSec": 5,
      "watch": true,
      "watchIntervalSec": 120,
      "notifyOffline": true,
      "notifyOnline": true,
      "notifyWan": true,
      "notifyPending": true,
      "notifyFirmware": true,
      "notifyCooldownMin": 10
    },
    "schema": [
      {
        "key": "showBarClients",
        "type": "boolean",
        "label": "Show the connected client count on the bar icon",
        "defaultValue": false
      },
      {
        "key": "showGatewayStats",
        "type": "boolean",
        "label": "Show the gateway's WAN graph, CPU, memory and uptime",
        "defaultValue": true
      },
      {
        "key": "showWifi",
        "type": "boolean",
        "label": "Show WiFi networks with their security in the panel",
        "defaultValue": true
      },
      {
        "key": "showNetworks",
        "type": "boolean",
        "label": "Show networks with their VLAN ids in the panel",
        "defaultValue": true
      },
      {
        "key": "showVpn",
        "type": "boolean",
        "label": "Show VPN servers and tunnels in the panel",
        "defaultValue": true
      },
      {
        "key": "showClients",
        "type": "boolean",
        "label": "Fetch the client list for type breakdown and per-device counts",
        "defaultValue": false
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval while the panel is open (seconds)",
        "min": 1,
        "max": 300,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "watch",
        "type": "boolean",
        "label": "Keep polling in the background for the bar badge and notifications",
        "defaultValue": true
      },
      {
        "key": "watchIntervalSec",
        "type": "integer",
        "label": "Background poll interval (seconds)",
        "min": 30,
        "max": 3600,
        "step": 30,
        "defaultValue": 120
      },
      {
        "key": "notifyOffline",
        "type": "boolean",
        "label": "Notify when a device goes offline",
        "defaultValue": true
      },
      {
        "key": "notifyOnline",
        "type": "boolean",
        "label": "Notify when a device comes back online",
        "defaultValue": true
      },
      {
        "key": "notifyWan",
        "type": "boolean",
        "label": "Notify when a WAN link goes down or recovers",
        "defaultValue": true
      },
      {
        "key": "notifyPending",
        "type": "boolean",
        "label": "Notify when a device waits for adoption",
        "defaultValue": true
      },
      {
        "key": "notifyFirmware",
        "type": "boolean",
        "label": "Notify when a firmware update becomes available",
        "defaultValue": true
      },
      {
        "key": "notifyCooldownMin",
        "type": "integer",
        "label": "Minimum minutes before re-notifying about the same device",
        "min": 1,
        "max": 240,
        "step": 1,
        "defaultValue": 10
      }
    ]
  }
}
