#!/bin/bash

# Run unifi-fetch against a stub controller. No credentials and no network
# beyond the loopback: the API key comes from a shim secret-tool on PATH.
#
# The point of the hostile cases is that a controller answer must never pick
# where the report cache is written or add lines to the curl config, so
# every identifier it returns is checked before it reaches a path or URL.

set -uo pipefail

TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly TEST_DIR
PLUGIN_DIR="$(dirname -- "$TEST_DIR")"
readonly PLUGIN_DIR

for cmd in python3 curl jq; do
  command -v "$cmd" >/dev/null 2>&1 || { echo "$cmd is required" >&2; exit 1; }
done

work=$(mktemp -d)
trap 'rm -rf "$work"; [[ -n ${stub_pid:-} ]] && kill "$stub_pid" 2>/dev/null' EXIT

# A shim secret-tool: the real one talks to the keyring, which CI has not.
# Storing and clearing succeed silently so unifi-login can run through.
# A no-op omarchy-shell keeps the login from poking a real widget.
mkdir -p "$work/bin"
cat >"$work/bin/secret-tool" <<'SHIM'
#!/bin/sh
case "$1" in lookup) printf 'test-key' ;; esac
SHIM
printf '#!/bin/sh\nexit 0\n' >"$work/bin/omarchy-shell"
chmod +x "$work/bin/secret-tool" "$work/bin/omarchy-shell"
export PATH="$work/bin:$PATH"

# Everything the scripts would touch on the machine is redirected here.
export XDG_STATE_HOME="$work/state"
export XDG_RUNTIME_DIR="$work/runtime"
mkdir -p "$XDG_RUNTIME_DIR"
export HOME="$work/home"
mkdir -p "$HOME"

# The stub serves the fixture as the Integration API, with the site list
# taken from $STUB_SITES so a case can hand back a hostile id. It records
# every request path so a test can assert what was (not) asked for.
cat >"$work/stub.py" <<'PY'
import json, os, sys
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import parse_qs, urlparse

fixture = json.load(open(os.environ["STUB_FIXTURE"]))
sites = json.loads(os.environ["STUB_SITES"])
mode = os.environ.get("STUB_MODE", "")
log = open(os.environ["STUB_LOG"], "a")

clients = [
    {"id": "c1", "name": "Workstation", "type": "WIRED",
     "ipAddress": "192.168.1.20", "macAddress": "aa:bb:cc:00:00:20",
     "uplinkDeviceId": "d1", "access": {"type": "DEFAULT"},
     "connectedAt": "2026-08-18T17:00:00Z"},
    {"id": "c2", "name": "Phone", "type": "WIRELESS",
     "ipAddress": "192.168.1.21", "macAddress": "aa:bb:cc:00:00:21",
     "uplinkDeviceId": "d1", "access": {"type": "DEFAULT"},
     "connectedAt": "2026-08-18T17:01:00Z"},
    {"id": "c3", "name": "Guest Phone", "type": "WIRELESS",
     "ipAddress": "192.168.1.22", "macAddress": "aa:bb:cc:00:00:22",
     "uplinkDeviceId": "d2", "access": {"type": "GUEST"},
     "connectedAt": "2026-08-18T17:02:00Z"},
    {"id": "c4", "name": "Road Warrior", "type": "VPN",
     "ipAddress": "10.0.0.2", "access": {"type": "DEFAULT"},
     "connectedAt": "2026-08-18T17:03:00Z"}]

class H(BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def _send(self, code, body):
        data = json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)
    def do_GET(self):
        log.write(self.path + "\n"); log.flush()
        if self.headers.get("X-API-KEY") != "test-key":
            return self._send(401, {"error": "no key"})
        p = self.path.split("?")[0]
        if p.endswith("/sites"):
            return self._send(200, {"data": sites, "totalCount": len(sites)})
        if p.endswith("/clients"):
            if mode == "manyclients":
                return self._send(200, {"data": [], "totalCount": 5000})
            return self._send(200, {"data": clients, "totalCount": len(clients)})
        if p.endswith("/info"):
            return self._send(200, {"applicationVersion": "10.6.101"})
        if p.endswith("/pending-devices"):
            return self._send(200, {"data": [
                {"model": "U6-Lite", "macAddress": "aa:bb:cc:00:00:09",
                 "ipAddress": "192.168.1.9", "state": "PENDING_ADOPTION",
                 "features": ["accessPoint"]}],
                "totalCount": 1})
        if p.endswith("/wifi/broadcasts"):
            return self._send(200, {"data": [
                {"name": "Home", "enabled": True, "type": "STANDARD",
                 "securityConfiguration": {"type": "WPA3_PERSONAL"}},
                {"name": "Guest", "enabled": False, "type": "STANDARD",
                 "securityConfiguration": {"type": "OPEN"}}],
                "totalCount": 2})
        if p.endswith("/networks"):
            return self._send(200, {"data": [
                {"name": "Default", "vlanId": 1, "enabled": True,
                 "management": "GATEWAY", "default": True},
                {"name": "Guest", "vlanId": 20, "enabled": False,
                 "management": "GATEWAY", "default": False}],
                "totalCount": 2})
        if p.endswith("/vpn/servers"):
            return self._send(200, {"data": [
                {"name": "Home VPN", "enabled": True, "type": "WIREGUARD"}],
                "totalCount": 1})
        if p.endswith("/vpn/site-to-site-tunnels"):
            return self._send(200, {"data": [
                {"name": "Office", "type": "IPSEC"}],
                "totalCount": 1})
        if p.endswith("/stat/health"):
            return self._send(200, {"data": [
                {"subsystem": "wlan", "num_user": 9, "num_guest": 0, "num_iot": 1},
                {"subsystem": "lan", "num_user": 5, "num_guest": 0, "num_iot": 0}]})
        if "/devices/" in p and not p.endswith("/statistics/latest"):
            did = p.rsplit("/", 1)[-1]
            for d in fixture["devices"]:
                if d["id"] == did:
                    return self._send(200, d)
            return self._send(404, {"error": "no such device"})
        if p.endswith("/devices"):
            items = fixture["devices"]
            if mode == "endless":
                # A plausible total that the served pages never reach.
                return self._send(200, {"data": items, "totalCount": 70})
            if mode == "bulky":
                # Each page stays under the per-response limit; two of
                # them together do not.
                fat = [dict(items[0], pad="x" * 15000) for _ in range(40)]
                return self._send(200, {"data": fat, "totalCount": 75})
            if mode == "manydevices":
                # A site past the device cap, with the gateway not
                # surfacing until the third page of the hunt.
                offset = int(parse_qs(urlparse(self.path).query).get("offset", ["0"])[0])
                gw = [d for d in items if "UCG" in (d.get("model") or "")]
                rest = [d for d in items if d not in gw]
                page = (rest * 200)[:200] if offset < 400 else (gw + rest * 200)[:200]
                return self._send(200, {"data": page, "totalCount": 5000})
            if mode == "huge":
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(b'{"data":[')
                for _ in range(40 * 1024):   # ~40 MB of one repeated device
                    self.wfile.write((json.dumps(items[0]) + ",").ljust(1024).encode())
                self.wfile.write(json.dumps(items[0]).encode() + b'],"totalCount":1}')
                return
            return self._send(200, {"data": items, "totalCount": len(items)})
        self._send(404, {"error": "unknown"})
    def do_POST(self):
        log.write("POST " + self.path + "\n"); log.flush()
        self._send(404, {"error": "unknown"})

srv = HTTPServer(("127.0.0.1", 0), H)
print(srv.server_port, flush=True)
srv.serve_forever()
PY

passed=0
failed=0
ok()   { printf '  ok    %s\n' "$1"; (( passed++ )); }
fail() { printf '  FAIL  %s\n        %s\n' "$1" "$2"; (( failed++ )); }

start_stub() { # sites-json [mode]
  STUB_FIXTURE="$TEST_DIR/fixtures/network.json" STUB_SITES="$1" STUB_MODE="${2:-}" STUB_LOG="$work/requests" \
    python3 "$work/stub.py" >"$work/port" 2>/dev/null &
  stub_pid=$!
  local _
  for _ in $(seq 1 50); do
    [[ -s $work/port ]] && break
    sleep 0.1
  done
  port=$(cat "$work/port")
  mkdir -p "$XDG_STATE_HOME/omarchy/unifi"
  # The config holds the first site's id, as unifi-login would have stored
  # it — written raw, so a hostile id lands in it the way a lying controller
  # would have planted it at setup.
  printf 'url=http://127.0.0.1:%s/integration/v1\nsite=%s\ninsecure=0\n' \
    "$port" "$(jq -r '.[0].id // ""' <<<"$1")" >"$XDG_STATE_HOME/omarchy/unifi/config"
  # Each case starts with a cold version cache so its /info request is its own.
  rm -f "$XDG_RUNTIME_DIR/omarchy-unifi/version.json"
}

stop_stub() {
  kill "$stub_pid" 2>/dev/null
  wait "$stub_pid" 2>/dev/null
  stub_pid=""
  rm -f "$work/port" "$work/requests"
}

echo "unifi-fetch against a stub controller:"

# A well-behaved controller: the fixture's site comes through and the
# report cache lands under the site's own id. A first poll resolves the
# site; a second poll given that answer back — as the widget does — must
# not query the site list again.
start_stub "$(jq -c '[.site]' "$TEST_DIR/fixtures/network.json")"
out=$("$PLUGIN_DIR/unifi-fetch")
out2=$("$PLUGIN_DIR/unifi-fetch" \
  "--site=$(jq -r '.site.id' <<<"$out")" "--site-ref=$(jq -r '.site.ref' <<<"$out")")
if jq -e '.error == null and (.site.name | length > 0) and .site.ref == "default"' >/dev/null 2>&1 <<<"$out" \
   && jq -e '.error == null and .site.ref == "default" and .site.name == ""
             and .summary.devices == 5' >/dev/null 2>&1 <<<"$out2" \
   && jq -e '.networkVersion == "10.6.101"' >/dev/null 2>&1 <<<"$out" \
   && jq -e '.pending.count == 1 and .pending.devices[0].model == "U6-Lite"
             and .pending.devices[0].ip == "192.168.1.9"' >/dev/null 2>&1 <<<"$out" \
   && jq -e '.wifi.count == 2 and .wifi.networks[0].security == "WPA3_PERSONAL"
             and .wifi.networks[1].enabled == false' >/dev/null 2>&1 <<<"$out" \
   && jq -e '.networks.count == 2 and .networks.networks[0].vlanId == 1
             and .networks.networks[0].standard == true
             and .networks.networks[1].enabled == false' >/dev/null 2>&1 <<<"$out" \
   && jq -e '.vpn.servers[0].type == "WIREGUARD"
             and .vpn.tunnels[0].name == "Office"' >/dev/null 2>&1 <<<"$out" \
   && (( $(grep -cF 'sites?' "$work/requests") == 1 )) \
   && ! grep -q clients "$work/requests"; then
  ok "renders the fixture; a poll handed the site skips the lookup"
else
  fail "renders the fixture; a poll handed the site skips the lookup" "$out ($(grep -cF 'sites?' "$work/requests") site list requests)"
fi
stop_stub

# The opt-in client list: type breakdown with guest split, VPN names and
# per-device counts joined by uplinkDeviceId (d1 takes two, d2 one).
start_stub "$(jq -c '[.site]' "$TEST_DIR/fixtures/network.json")"
out=$("$PLUGIN_DIR/unifi-fetch" --clients)
if jq -e '.error == null and .clientsDetail.count == 4
         and .clientsDetail.wired == 1 and .clientsDetail.wireless == 2
         and .clientsDetail.vpn == 1 and .clientsDetail.teleport == 0
         and .clientsDetail.guests == 1
         and .clientsDetail.vpnClients[0].name == "Road Warrior"
         and .clientsDetail.list[1].kind == "wireless"
         and .clientsDetail.list[1].ip == "192.168.1.21"
         and ([.devices[] | select(.id == "d1")][0].clients) == 2
         and ([.devices[] | select(.id == "d2")][0].clients) == 1
         and ([.devices[] | select(.id == "d4")][0].clients) == 0' \
     >/dev/null 2>&1 <<<"$out" \
   && (( $(grep -cF '/clients?' "$work/requests") == 1 )); then
  ok "fetches the client list with --clients: breakdown and per-device join"
else
  fail "fetches the client list with --clients: breakdown and per-device join" "${out:0:300}"
fi
stop_stub

# Past the row cap only the claimed total survives; the breakdown hides so
# the panel shows the count instead of a partial split.
start_stub "$(jq -c '[.site]' "$TEST_DIR/fixtures/network.json")" manyclients
out=$("$PLUGIN_DIR/unifi-fetch" --clients)
if jq -e '.error == null and .clientsDetail.count == 5000
         and .clientsDetail.wired == null
         and .clientsDetail.vpnClients == []' >/dev/null 2>&1 <<<"$out"; then
  ok "falls back to the claimed client count past the row cap"
else
  fail "falls back to the claimed client count past the row cap" "${out:0:300}"
fi
stop_stub

# A stored site id that tries to escape the cache directory and to append
# curl directives — what a lying controller could have planted at setup.
# The fetch must give up on the site rather than use it.
evil_id=$'../../home/escaped"\noutput = '"$HOME/pwned"$'\nurl = "http://127.0.0.1:1/'
start_stub "$(jq -cn --arg id "$evil_id" '[{id: $id, name: "Default", internalReference: "default"}]')"
out=$("$PLUGIN_DIR/unifi-fetch")
if jq -e '.error | test("site id")' >/dev/null 2>&1 <<<"$out"; then
  ok "refuses a site id that is not a plain token"
else
  fail "refuses a site id that is not a plain token" "$out"
fi
if [[ ! -e $HOME/pwned ]] && [[ -z $(find "$work" -name '*escaped*' -o -name 'pwned' 2>/dev/null) ]]; then
  ok "writes nothing outside the report cache directory"
else
  fail "writes nothing outside the report cache directory" "$(find "$work" -newer "$work/stub.py" -type f)"
fi
if ! grep -q 'escaped' "$work/requests" 2>/dev/null; then
  ok "sends no request built from the hostile id"
else
  fail "sends no request built from the hostile id" "$(cat "$work/requests")"
fi
stop_stub

# A hostile internal reference and device id are optional data: the fetch
# still succeeds, but the classic-API calls that would use them are skipped.
evil_ref=$'default"\noutput = '"$HOME/pwned2"
start_stub "$(jq -cn --arg ref "$evil_ref" '[{id: "site-1", name: "Default", internalReference: $ref}]')"
out=$("$PLUGIN_DIR/unifi-fetch")
if jq -e '.error == null' >/dev/null 2>&1 <<<"$out" && [[ ! -e $HOME/pwned2 ]] \
   && ! grep -q 'POST\|stat/health' "$work/requests" 2>/dev/null; then
  ok "skips the classic API when the internal reference is not a plain token"
else
  fail "skips the classic API when the internal reference is not a plain token" "$out
$(cat "$work/requests" 2>/dev/null)"
fi
stop_stub

# A controller that always reports more pages must not keep the fetch going.
good_sites=$(jq -c '[.site]' "$TEST_DIR/fixtures/network.json")
start_stub "$good_sites" endless
out=$(timeout 60 "$PLUGIN_DIR/unifi-fetch")
if jq -e '.error | test("without end")' >/dev/null 2>&1 <<<"$out" \
   && (( $(grep -cF '/devices?' "$work/requests") <= 5 )); then
  ok "stops following pages after a bounded number"
else
  fail "stops following pages after a bounded number" "$out ($(grep -cF '/devices?' "$work/requests") device requests)"
fi
stop_stub

# More devices than the cap degrades instead of dying: the claimed count,
# the controller version from /info, the gateway hunted down by paging, and
# client counts from the health rows — with the client list never requested.
start_stub "$good_sites" manydevices
out=$(timeout 60 "$PLUGIN_DIR/unifi-fetch")
if jq -e '.error == null and .oversized == true and .summary.devices == 5000
          and (.devices | length) == 1 and .devices[0].kind == "gateway"
          and (.controller.url | startswith("http://127.0.0.1:"))
          and .summary.clients == 15 and .summary.wireless == 10
          and .summary.wired == 5' >/dev/null 2>&1 <<<"$out" \
   && jq -e '.networkVersion == "10.6.101"' >/dev/null 2>&1 <<<"$out" \
   && ! grep -q clients "$work/requests"; then
  ok "falls back to controller and gateway details on an oversized site"
else
  fail "falls back to controller and gateway details on an oversized site" "${out:0:300}"
fi

# A second poll handed the gateway id — as the widget does — must fetch it
# by id instead of hunting the device pages again: it may add exactly one
# more page request (its own overflow probe) plus the by-id request.
# (The pending-devices request carries no leading slash before "devices",
# so the '/devices?' match counts device pages only.)
hunt_pages=$(grep -cF '/devices?' "$work/requests")
out2=$(timeout 60 "$PLUGIN_DIR/unifi-fetch" \
  "--site=$(jq -r '.site.id' <<<"$out")" "--site-ref=$(jq -r '.site.ref' <<<"$out")" \
  "--gateway=$(jq -r '.gateway.id' <<<"$out")")
if jq -e '.error == null and .oversized == true and .devices[0].kind == "gateway"' >/dev/null 2>&1 <<<"$out2" \
   && (( $(grep -cF '/devices?' "$work/requests") == hunt_pages + 1 )) \
   && (( $(grep -cF '/info' "$work/requests") == 1 )) \
   && grep -q 'devices/d4' "$work/requests"; then
  ok "a poll handed the gateway id skips the hunt"
else
  fail "a poll handed the gateway id skips the hunt" "${out2:0:200} ($(grep -cF '/devices?' "$work/requests") vs $hunt_pages page requests)"
fi
stop_stub

# Pages that each fit the per-response limit must not add up past it.
start_stub "$good_sites" bulky
out=$(timeout 60 "$PLUGIN_DIR/unifi-fetch")
if jq -e '.error | test("MB of")' >/dev/null 2>&1 <<<"$out"; then
  ok "stops accumulating pages at the byte budget"
else
  fail "stops accumulating pages at the byte budget" "${out:0:300}"
fi
stop_stub

# Nor may it make the shell hold an arbitrarily large body.
start_stub "$good_sites" huge
out=$(timeout 60 "$PLUGIN_DIR/unifi-fetch")
if jq -e '.error | test("larger than")' >/dev/null 2>&1 <<<"$out"; then
  ok "gives up on a response body over the size limit"
else
  fail "gives up on a response body over the size limit" "${out:0:300}"
fi
stop_stub

# unifi-login prints controller-chosen site labels to the terminal, so a
# name carrying escape sequences must come out defanged. The setup answers
# are fed on stdin: the stub's URL, the TLS default, and an empty key to
# keep the one the shim "stored".
evil_label=$'Evil\e]0;pwned\a\e[31m site\x01'
start_stub "$(jq -cn --arg n "$evil_label" '[{id: "site-1", name: $n, internalReference: "default"}]')"
out=$(printf 'http://127.0.0.1:%s/integration/v1\n\n\n' "$port" | "$PLUGIN_DIR/unifi-login" 2>&1)
if grep -q '^Site: Evil' <<<"$out" && grep -q 'Signed in' <<<"$out" \
   && ! (printf '%s' "$out" | tr -d '\n' | grep -q '[[:cntrl:]]'); then
  ok "strips control characters from site labels before printing them"
else
  fail "strips control characters from site labels before printing them" "$(printf '%s' "$out" | od -c | head -20)"
fi
stop_stub

# The curl helpers themselves refuse config-breaking input, whatever the caller.
# shellcheck source=lib/unifi-common.sh
source "$PLUGIN_DIR/lib/unifi-common.sh"
UNIFI_API_BASE="http://127.0.0.1:1"
unifi_http $'/x"\noutput = '"$HOME/pwned3" "key"
if [[ $UNIFI_HTTP_CODE == 000 && ! -e $HOME/pwned3 ]]; then
  ok "unifi_http refuses a path that would break the curl config"
else
  fail "unifi_http refuses a path that would break the curl config" "$UNIFI_HTTP_CODE $UNIFI_HTTP_BODY"
fi
if unifi_is_token "8fd8b3f4-1c2e-4b1e-9d0a-000000000000" && unifi_is_token "default" \
   && ! unifi_is_token "" && ! unifi_is_token "a/b" && ! unifi_is_token "a b" && ! unifi_is_token 'a"b'; then
  ok "unifi_is_token accepts ids and rejects separators"
else
  fail "unifi_is_token accepts ids and rejects separators" ""
fi

echo
echo "$passed passed, $failed failed"
(( failed == 0 ))
